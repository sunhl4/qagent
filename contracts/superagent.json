{
  "version": "1.3.0",
  "fail_closed": true,
  "accept_modes": ["off", "observe", "auto"],
  "default_accept_mode": "observe",
  "default_source": "company",
  "limits": {
    "source_bytes": 64,
    "thread_id_bytes": 128,
    "actor_id_bytes": 200,
    "trigger_text_bytes": 4000,
    "scope_bytes": 1500,
    "title_bytes": 200,
    "worktree_name_bytes": 64,
    "report_bytes": 1200,
    "max_query_items": 100,
    "tenant_id_bytes": 80,
    "subject_id_bytes": 80,
    "idempotency_key_bytes": 200,
    "policy_version_bytes": 80,
    "session_ref_bytes": 80,
    "tool_pack_bytes": 80
  },
  "db_env": "COMPANY_AGENT_WORK_ITEM_DB",
  "db_default_dir": "work-items",
  "states": {
    "ticket": ["open", "ended"],
    "assignment": ["pending", "running", "ended"],
    "report": ["progress", "waiting", "ready", "blocked", "failed", "dropped"],
    "decision": ["accept", "ignore", "stop", "unavailable"]
  },
  "source_kinds": ["company", "github", "feishu", "workspace", "research"],
  "control_plane": {
    "schema_version": "1",
    "event_fields": ["schema_version", "tenant_id", "source", "idempotency_key", "subject_id", "mandate", "policy_version"],
    "unknown_retryable": false,
    "ledger_role": "local-control-plane",
    "company_fact_store": false,
    "cross_tenant_read": "deny",
    "open_sources": ["company", "workspace", "research"],
    "execution_fields": ["session_ref", "tool_pack"],
    "recover_fields": ["assignment_id", "ticket_id", "execution_state", "session_ref", "tool_pack", "thread_key"],
    "default_policy_version": "company-policy",
    "ticket_rule": {"mode": "auto", "strength": "explicit"},
    "reconcile_rule": {"from_execution": "unknown", "to_execution": "ended", "to_ticket": "ended"}
  },
  "architecture": {
    "name": "company-super-dsh",
    "audience": "company",
    "second_runtime": false,
    "clocks": {
      "agent": {
        "owner": "control",
        "objects": ["source", "trigger", "eval", "mandate", "ticket", "assignment", "subscription"],
        "fact_store": "local-control-plane"
      },
      "platform": {
        "owner": "research-layer",
        "objects": ["experiment", "lease", "budget", "evidence"],
        "fact_store": "research-layer"
      }
    },
    "planes": {
      "control": {"starts_model_loop": false, "owns": ["source", "trigger", "eval", "mandate", "ticket", "assignment", "subscription"]},
      "execution": {"starts_model_loop": false, "executor": "existing-dsh-session", "owns": ["dsh-session", "tool-pack"]},
      "platform": {"starts_model_loop": false, "enters_as": "research-trigger", "owns": ["research-layer"]}
    },
    "channels": {"company": true, "workspace": true, "research": true, "github": false, "feishu": false},
    "watchdog": {"may_open_ticket": false, "may_change_policy": false, "may_retry_unknown": false, "implementation": "company-policy"},
    "signal_types": ["experiment.completed.v1", "lease.changed.v1", "budget.exhausted.v1"]
  },
  "retention": {
    "max_events": 100000,
    "max_triggers": 100000,
    "max_tickets": 10000
  },
  "framework": {
    "runtime": "deepseek-harness",
    "compatible_runtime_versions": ["0.1.5-rc.2"],
    "prototype": "dsh-superagent-prototype",
    "prototype_objects": ["source", "trigger", "eval", "mandate", "ticket", "assignment", "subscription"],
    "official_status": "unreleased",
    "migration_mode": "dsh-plugin-pack",
    "executor": "existing-dsh-session",
    "connectors": {"github": false, "feishu": false},
    "forbidden_worker_modes": ["danger-full-access", "shell", "second-loop"],
    "mandate_scopes": ["boot", "lab", "algo", "sign"]
  }
}
