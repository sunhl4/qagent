{
  "name": "cirq_simulator_run",
  "description": "Cirq simulator shots. provenance=cirq. MUST NOT emit twin_id.",
  "status": "wired",
  "parameters": {
    "type": "object",
    "required": ["circuit_id", "shots"],
    "properties": {
      "circuit_id": { "type": "string" },
      "shots": { "type": "integer", "minimum": 1 }
    }
  },
  "output": {
    "type": "object",
    "required": ["provenance", "counts"],
    "properties": {
      "provenance": { "const": "cirq" },
      "counts": { "type": "object" },
      "shots_actual": { "type": "integer" }
    },
    "additionalProperties": false
  },
  "forbidden_output_keys": ["twin_id", "ok", "signoff"]
}
