{
  "name": "ionstack_twin_run",
  "description": "POST /v1/twin/run. Algorithm side submits LogicalCircuit only.",
  "parameters": {
    "type": "object",
    "required": ["mode", "shots", "circuit"],
    "properties": {
      "mode": { "type": "string", "enum": ["pipeline", "signoff"] },
      "shots": { "type": "integer", "minimum": 1 },
      "seed": { "type": ["integer", "null"] },
      "circuit": {
        "type": "object",
        "required": ["body"],
        "properties": {
          "n_qubits": { "type": "integer" },
          "n_instructions": { "type": "integer" },
          "body": { "type": "object" }
        }
      }
    },
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "required": ["twin_id", "counts"],
    "properties": {
      "twin_id": { "type": "string" },
      "counts": { "type": "object" },
      "shots_actual": { "type": "integer" },
      "makespan_ns": { "type": "number" }
    }
  },
  "forbidden_input_keys": ["calibration", "cal", "shuttle", "ms_matrix"],
  "notes": "Aer approximate path must not emit this twin_id."
}
