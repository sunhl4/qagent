{
  "name": "qagent_hub_describe",
  "description": "Describe one algo-hub card. No circuit body.",
  "parameters": {
    "type": "object",
    "required": ["id"],
    "properties": {
      "id": { "type": "string" },
      "algorithm_id": { "type": "string" }
    }
  },
  "output": {
    "type": "object",
    "required": ["id", "kind", "title"],
    "properties": {
      "id": { "type": "string" },
      "kind": { "type": "string" },
      "title": { "type": "string" },
      "maturity": { "type": "string" },
      "summary": { "type": "string" },
      "native_format": { "type": "string" },
      "choose_when": { "type": "array" },
      "do_not_choose_when": { "type": "array" },
      "selectable": { "type": "boolean" }
    },
    "additionalProperties": false
  },
  "forbidden_output_keys": ["qasm3", "body", "twin_id", "token"]
}
