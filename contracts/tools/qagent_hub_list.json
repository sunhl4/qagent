{
  "name": "qagent_hub_list",
  "description": "List company algorithm/software cards from algo-hub. Short rows only.",
  "parameters": {
    "type": "object",
    "properties": {
      "kind": {
        "type": "string",
        "description": "Optional kind filter: algorithm / runtime / compiler / workflow"
      }
    }
  },
  "output": {
    "type": "object",
    "required": ["assets", "count"],
    "properties": {
      "assets": { "type": "array" },
      "count": { "type": "integer" },
      "source": { "type": "string" }
    },
    "additionalProperties": false
  },
  "forbidden_output_keys": ["qasm3", "body", "twin_id", "token"]
}
