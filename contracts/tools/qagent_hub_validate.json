{
  "name": "qagent_hub_validate",
  "description": "Validate a hub/v1 config envelope. Does not run the algorithm.",
  "parameters": {
    "type": "object",
    "required": ["config"],
    "properties": {
      "config": { "type": "object" }
    }
  },
  "output": {
    "type": "object",
    "required": ["ok", "errors"],
    "properties": {
      "ok": { "type": "boolean" },
      "errors": { "type": "array" },
      "algorithm_id": { "type": "string" }
    },
    "additionalProperties": false
  },
  "forbidden_output_keys": ["qasm3", "body", "twin_id", "token"]
}
