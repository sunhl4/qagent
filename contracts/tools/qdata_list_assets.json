{
  "name": "qdata_list_assets",
  "description": "Short catalog of recipes, cards, and knowledge hits. Name plus asset_id or recipe id. No Pauli / QASM body.",
  "parameters": {
    "type": "object",
    "properties": {
      "store_dir": {
        "type": "string"
      }
    }
  },
  "output": {
    "type": "object",
    "required": [
      "assets"
    ],
    "properties": {
      "assets": {
        "type": "array",
        "maxItems": 20,
        "items": {
          "type": "object",
          "required": [
            "name",
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "recipe",
                "card",
                "knowledge"
              ]
            },
            "name": {
              "type": "string",
              "maxLength": 80
            },
            "asset_id": {
              "type": "string"
            },
            "recipe": {
              "type": "string",
              "maxLength": 80
            }
          }
        }
      }
    }
  },
  "forbidden_output_keys": [
    "bitstrings",
    "rows",
    "pauli_terms",
    "counts_full",
    "result_full",
    "qasm3",
    "body",
    "twin_id"
  ]
}
