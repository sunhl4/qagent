{
  "name": "qiskit_ibm_run",
  "description": "Reserved. Foreign IBM backend. Never writes twin_id. Disabled until a pack is approved.",
  "status": "reserved",
  "parameters": {
    "type": "object",
    "required": ["circuit_id", "shots"],
    "properties": {
      "circuit_id": { "type": "string" },
      "shots": { "type": "integer" },
      "backend": { "type": "string" }
    }
  },
  "output": {
    "type": "object",
    "required": ["provenance"],
    "properties": { "provenance": { "const": "ibm" }, "job_id": { "type": "string" } }
  },
  "forbidden_output_keys": ["twin_id"]
}
