{
  "name": "qiskit_transpile",
  "description": "Qiskit transpile preset on a pinned circuit. Not a QCCD signoff.",
  "parameters": {
    "type": "object",
    "required": ["circuit_id"],
    "properties": {
      "circuit_id": { "type": "string" },
      "preset": { "type": "string" }
    }
  },
  "output": {
    "type": "object",
    "required": ["circuit_id"],
    "properties": { "circuit_id": { "type": "string" }, "summary": { "type": "object" } }
  },
  "forbidden_output_keys": ["twin_id", "ok"]
}
