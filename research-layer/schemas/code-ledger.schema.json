{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://company.example/schemas/code-ledger.schema.json",
  "title": "CodeLedgerEntry",
  "description": "Pinned code availability for one paper. none requires a missing-information note.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code_id",
    "paper_id",
    "source_kind",
    "version",
    "availability"
  ],
  "properties": {
    "code_id": {"type": "string", "minLength": 1, "maxLength": 80},
    "paper_id": {"type": "string", "minLength": 1, "maxLength": 80},
    "source_kind": {
      "type": "string",
      "enum": ["arxiv_src", "jats", "html", "pdf_text", "figure_asset"]
    },
    "version": {"type": "string", "minLength": 1, "maxLength": 80},
    "availability": {"type": "string", "enum": ["official", "third_party", "none"]},
    "url": {"type": ["string", "null"], "maxLength": 300},
    "commit": {"type": ["string", "null"], "maxLength": 80},
    "license": {"type": ["string", "null"], "maxLength": 80},
    "missing_information": {"type": "array", "items": {"type": "string", "maxLength": 200}}
  }
}
