{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://company.example/schemas/daily-report.schema.json",
  "title": "DailyReport",
  "description": "Daily research report aggregated from experiment loop summaries. Facts only; no model-generated conclusions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "date",
    "generated_at",
    "goals",
    "experiments",
    "key_results",
    "negative_results",
    "failures",
    "costs",
    "human_decisions",
    "next_steps",
    "markdown"
  ],
  "properties": {
    "report_id": {"type": "string", "minLength": 1},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "goals": {"type": "array", "items": {"type": "string"}},
    "experiments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["experiment_id", "attempts", "kept", "discarded", "failed", "costs"],
        "properties": {
          "experiment_id": {"type": "string"},
          "attempts": {"type": "integer", "minimum": 0},
          "kept": {"type": "integer", "minimum": 0},
          "discarded": {"type": "integer", "minimum": 0},
          "failed": {"type": "integer", "minimum": 0},
          "costs": {
            "type": "object",
            "additionalProperties": {"type": "number", "minimum": 0}
          }
        }
      }
    },
    "key_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["experiment_id", "run_id", "decision", "reason"],
        "properties": {
          "experiment_id": {"type": "string"},
          "run_id": {"type": "string"},
          "decision": {
            "type": "string",
            "enum": ["keep", "discard", "extend", "stop", "escalate"]
          },
          "reason": {"type": ["string", "null"]}
        }
      }
    },
    "negative_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["experiment_id", "run_id", "category", "code", "message"],
        "properties": {
          "experiment_id": {"type": "string"},
          "run_id": {"type": "string"},
          "category": {
            "type": ["string", "null"],
            "enum": [
              "implementation",
              "data",
              "metric",
              "resource",
              "hypothesis",
              "environment",
              "instability",
              "policy",
              "unknown",
              null
            ]
          },
          "code": {"type": ["string", "null"]},
          "message": {"type": ["string", "null"]}
        }
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "count", "codes"],
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "implementation",
              "data",
              "metric",
              "resource",
              "hypothesis",
              "environment",
              "instability",
              "policy",
              "unknown"
            ]
          },
          "count": {"type": "integer", "minimum": 0},
          "codes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "costs": {
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 0}
    },
    "human_decisions": {"type": "array", "items": {"type": "string"}},
    "next_steps": {"type": "array", "items": {"type": "string"}},
    "markdown": {"type": "string", "minLength": 1}
  }
}
