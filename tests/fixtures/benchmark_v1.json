{
  "version": "v1",
  "cases": [
    {
      "pack_id": "qdata",
      "invoke_tool": "qdata_run_recipe",
      "required_input_fields": ["name"],
      "required_output_fields": ["asset_id"],
      "forbidden_output_fields": ["twin_id"]
    },
    {
      "pack_id": "qchem",
      "invoke_tool": "qchem_run",
      "required_input_fields": ["scenario"],
      "required_output_fields": ["asset_id"],
      "forbidden_output_fields": ["twin_id"]
    },
    {
      "pack_id": "ionstack",
      "invoke_tool": "ionstack_twin_identity",
      "required_input_fields": [],
      "required_output_fields": ["preset", "live"],
      "forbidden_output_fields": ["twin_id"]
    },
    {
      "pack_id": "route",
      "invoke_tool": "ionstack_compile_estimate",
      "required_input_fields": ["circuit"],
      "required_output_fields": ["makespan_ns"],
      "forbidden_output_fields": ["ok", "twin_id"]
    },
    {
      "pack_id": "qiskit",
      "invoke_tool": "qiskit_aer_run",
      "required_input_fields": ["circuit_id", "shots"],
      "required_output_fields": ["provenance"],
      "forbidden_output_fields": ["twin_id"],
      "output_const": {
        "provenance": "aer"
      }
    },
    {
      "pack_id": "cirq",
      "invoke_tool": "cirq_simulator_run",
      "required_input_fields": ["circuit_id", "shots"],
      "required_output_fields": ["provenance"],
      "forbidden_output_fields": ["twin_id"],
      "output_const": {
        "provenance": "cirq"
      }
    }
  ]
}
