{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2023"]
  },
  "include": [
    "contracts/src/**/*.ts",
    "packages/*/src/**/*.ts",
    "adapters/*/src/**/*.ts",
    "tests/**/*.ts"
  ]
}
